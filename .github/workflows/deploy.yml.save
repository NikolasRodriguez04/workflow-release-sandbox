
name: Deploy

permissions:
  id-token: write
  contents: read

on:
  push:
    branches:
      - development
      - master
      - 'release/*'        # ← AGREGADO
  workflow_dispatch:
    inputs:
      branch:
        required: true
        type: string

# --- NUEVO JOB SOLO PARA SABER CUÁL ES EL RELEASE MÁS ALTO ---
jobs:
  detect-release:
    # Solo corre si el evento es un push a release/*
    if: startsWith(github.ref_name, 'release/')
    runs-on: ubuntu-latest
    outputs:
      highest: ${{ steps.find.outputs.highest_release }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - id: find
        run: |
          releases=$(git branch -r | grep 'origin/release/' | sed 's|origin/||')
          highest=$(echo "$releases" | sort -V | tail -n 1)
          echo "highest_release=$highest" >> $GITHUB_OUTPUT


  # --- TUS JOBS ORIGINALES (NO BORRO NADA) ---
  validate:
    needs: detect-release
    # IF ORIGINAL + requisito extra para automatización
    if: >
      (
        (github.event_name == 'push' || startsWith(github.event.inputs.branch, 'release/'))
        &&
        (
          github.event_name != 'push' 
          || needs.detect-release.outputs.highest == '' 
          || github.ref_name == needs.detect-release.outputs.highest
        )
      )
    uses: itrocksweb/workflows/.github/workflows/doppler-variables-validation.yml@master
    with:
      ENVIRONMENT: ${{ github.ref == 'refs/heads/master' && 'production' || 'test' }}
    secrets:
      DOPPLER_TOKEN: ${{ secrets.DOPPLER_TOKEN }}

  deploy:
    needs: validate
    # IF ORIGINAL + requisito extra
    if: >
      (
        (github.event_name == 'push' || startsWith(github.event.inputs.branch, 'release/'))
        &&
        (
          github.event_name != 'push' 
          || needs.detect-release.outputs.highest == '' 
          || github.ref_name == needs.detect-release.outputs.highest
        )
      )
    uses: itrocksweb/workflows/.github/workflows/aws-ecs-deploy.yml@master
    with:
      AWS_ROLE_TO_ASSUME: ${{ vars.APER_AWS_ROLE_TO_ASSUME }}
      AWS_REGION: ${{ vars.APER_AWS_REGION }}
      ENVIRONMENT: ${{ github.ref == 'refs/heads/master' && 'production' || 'test' }}
      VERSION_VARIABLE_NAME: NEXT_PUBLIC_VERSION
      DOPPLER_DOWNLOAD_SECRETS: true
    secrets:
      DOPPLER_TOKEN: ${{ secrets.DOPPLER_TOKEN }}


